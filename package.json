{
	"name": "simple-citations",
	"version": "1.9.0",
	"description": "Add & update simple literature notes from Zotero.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "jest",
		"sync-version": "node version-bump.mjs && git add manifest.json versions.json",
		"version": "pnpm run sync-version"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"packageManager": "pnpm@11.21.0",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/jest": "^29.5.14",
		"@types/node": "^16.11.6",
		"esbuild": "^0.27.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.12.0",
		"jest": "^29.7.0",
		"jest-util": "^29.7.0",
		"obsidian": "latest",
		"ts-jest": "^29.4.5",
		"tslib": "2.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.69.0"
	}
}
